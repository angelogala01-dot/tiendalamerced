# Supabase
SUPABASE_URL=https://idbzttrtzmhrlwsomphz.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Server (Railway inyecta PORT; no lo definas ahí)
PORT=4000
# Local: localhost. Producción: URLs públicas de frontend y admin, separadas por coma
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Opcional: para npm run db:apply (Settings → Database → Connection string)
# DATABASE_URL=postgresql://postgres.idbzttrtzmhrlwsomphz:[PASSWORD]@...pooler.supabase.com:5432/postgres

# Nubefact (facturas y boletas electrónicas)
NUBEFACT_URL=https://api.nubefact.com/api/v1/tu-ruta
NUBEFACT_TOKEN=tu-token
NUBEFACT_SERIE_FACTURA=F001
NUBEFACT_SERIE_BOLETA=B001

# Decolecta — DNI (RENIEC) y RUC (SUNAT)
DECOLECTA_URL=https://api.decolecta.com/v1
DECOLECTA_TOKEN=tu-token

# OpenAI — asistente virtual (nunca en el frontend)
OPENAI_API_KEY=sk-proj-tu-clave
OPENAI_MODEL=gpt-4o-mini

# Resend — correos transaccionales (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxx
# Dominio verificado: whoami.business
RESEND_FROM=La Merced <noreply@whoami.business>
RESEND_REPLY_TO=info@whoami.business
# Destinatario opcional para: npm run mail:test / node scripts/diagnose-resend.mjs
# RESEND_TEST_TO=tu-correo@real.com
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
