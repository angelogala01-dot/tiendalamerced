# Copia estos valores en Variables de cada servicio de Railway.
# Las URLs públicas se ven en Settings → Networking → Generate Domain.

# =============================================================================
# Servicio: api   (Root Directory = backend)
# =============================================================================
NODE_ENV=production
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Tras generar dominios: https://tienda.up.railway.app,https://admin.up.railway.app
CORS_ORIGIN=https://TU-FRONTEND.up.railway.app,https://TU-ADMIN.up.railway.app
FRONTEND_URL=https://TU-FRONTEND.up.railway.app
ADMIN_URL=https://TU-ADMIN.up.railway.app

NUBEFACT_URL=
NUBEFACT_TOKEN=
NUBEFACT_SERIE_FACTURA=F001
NUBEFACT_SERIE_BOLETA=B001

DECOLECTA_URL=https://api.decolecta.com/v1
DECOLECTA_TOKEN=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

RESEND_API_KEY=
RESEND_FROM=La Merced <noreply@tu-dominio.com>
RESEND_REPLY_TO=info@tu-dominio.com

# =============================================================================
# Servicio: frontend   (Root Directory = frontend)
# NEXT_PUBLIC_* se inyectan en el BUILD: redespliega si las cambias.
# =============================================================================
NODE_ENV=production
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=https://TU-API.up.railway.app/api/v1
NEXT_PUBLIC_ADMIN_URL=https://TU-ADMIN.up.railway.app
NEXT_PUBLIC_SITE_URL=https://TU-FRONTEND.up.railway.app

# =============================================================================
# Servicio: admin   (Root Directory = admin)
# =============================================================================
NODE_ENV=production
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=https://TU-API.up.railway.app/api/v1
NEXT_PUBLIC_STORE_URL=https://TU-FRONTEND.up.railway.app
