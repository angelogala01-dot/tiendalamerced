# Copia estos valores en Variables de cada servicio de Railway.
# Las URLs públicas se ven en Settings → Networking → Generate Domain.

# =============================================================================
# Servicio: api   (Root Directory = backend)
# =============================================================================
NODE_ENV=production
SUPABASE_URL=https://idbzttrtzmhrlwsomphz.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# No definas PORT en Railway: elige el puerto el propio Railway.
CORS_ORIGIN=https://rare-growth-production.up.railway.app,https://overflowing-analysis-production-0c04.up.railway.app
FRONTEND_URL=https://rare-growth-production.up.railway.app
ADMIN_URL=https://overflowing-analysis-production-0c04.up.railway.app

NUBEFACT_URL=
NUBEFACT_TOKEN=
NUBEFACT_SERIE_FACTURA=F001
NUBEFACT_SERIE_BOLETA=B001

DECOLECTA_URL=https://api.decolecta.com/v1
DECOLECTA_TOKEN=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

RESEND_API_KEY=
RESEND_FROM=La Merced <noreply@tu-dominio.com>
RESEND_REPLY_TO=info@tu-dominio.com

# =============================================================================
# Servicio: frontend   (Root Directory = frontend)
# NEXT_PUBLIC_* se inyectan en el BUILD: redespliega si las cambias.
# =============================================================================
